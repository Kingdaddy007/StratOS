{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-os.dev/schemas/manifest.schema.json",
  "title": "Anti-Gravity OS manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "os_version",
    "canonical",
    "hosts",
    "profiles",
    "profile_definitions",
    "mutation_classes",
    "skills",
    "workflows",
    "context_templates",
    "baselines",
    "templates",
    "resources",
    "agents"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "os_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "canonical": { "type": "object" },
    "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "profile_definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "extends"],
        "properties": {
          "kind": { "enum": ["base", "pack"] },
          "extends": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "mutation_classes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "skills": { "$ref": "#/$defs/registry" },
    "workflows": { "$ref": "#/$defs/registry" },
    "context_templates": { "$ref": "#/$defs/registry" },
    "baselines": { "$ref": "#/$defs/registry" },
    "templates": { "$ref": "#/$defs/registry" },
    "resources": { "$ref": "#/$defs/registry" },
    "agents": { "$ref": "#/$defs/agent_registry" }
  },
  "$defs": {
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "profiles", "functional_owner", "delivery_role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "functional_owner": { "type": "string", "pattern": "^[a-z_]+$" },
          "delivery_role": { "type": "string", "pattern": "^[a-z_]+$" }
        }
      }
    },
    "agent_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "profiles", "functional_owner", "delivery_role", "host_compatibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "functional_owner": { "type": "string", "pattern": "^[a-z_]+$" },
          "delivery_role": { "type": "string", "pattern": "^[a-z_]+$" },
          "host_compatibility": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
