{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-os.dev/schemas/agent.schema.json",
  "title": "Anti-Gravity canonical agent contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "functional_owner",
    "delivery_role",
    "profiles",
    "activation",
    "exclusions",
    "default_mutation_class",
    "allowed_mutation_classes",
    "tool_capabilities",
    "primary_agent",
    "subagent",
    "can_delegate",
    "model_tier",
    "command_policy",
    "skills",
    "return_contract",
    "delegation_contract"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "functional_owner": { "type": "string", "pattern": "^[a-z_]+$" },
    "delivery_role": { "enum": ["orchestrator", "functional_lead", "independent_assurance"] },
    "profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "activation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "default_mutation_class": { "type": "string" },
    "allowed_mutation_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tool_capabilities": { "type": "array", "items": { "type": "string" } },
    "primary_agent": { "type": "boolean" },
    "subagent": { "type": "boolean" },
    "can_delegate": { "type": "boolean" },
    "model_tier": { "enum": ["inherit", "flash", "pro"] },
    "command_policy": { "enum": ["off", "sandbox"] },
    "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "return_contract": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "delegation_contract": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "conditional_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profiles", "skills"],
        "properties": {
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
